{
  "title": "Overwork",
  "children": [
    {
      "title": "What it is",
      "lines": [
        "20 FX machines on",
        "the live input, with",
        "a step sequencer",
        "that parameter-locks",
        "them.",
        "Two insert slots in",
        "series, two FX LFOs."
      ]
    },
    {
      "title": "The main gesture",
      "lines": [
        "HOLD a step button",
        "and TURN a knob.",
        "That parameter is",
        "now locked on that",
        "step.",
        "Hold+Shift+knob",
        "edits the base",
        "value instead."
      ]
    },
    {
      "title": "Step buttons",
      "lines": [
        "Tap: trig on/off",
        "Hold+knob: lock",
        "Hold+Shift+knob:",
        "  edit base value",
        "Hold+jog: set the",
        "  attribute the mode",
        "  pad selected",
        "Shift+pad 75:",
        "  clear its locks"
      ]
    },
    {
      "title": "Step LEDs",
      "lines": [
        "Dim: in length,",
        "no trig",
        "White: plain trig",
        "Green: has locks",
        "Cyan: conditional",
        "Red: playhead",
        "Bright green: held"
      ]
    },
    {
      "title": "Pads rows 1-3",
      "lines": [
        "Machine palette,",
        "21 machines.",
        "Tap to load one",
        "into the focused",
        "slot. The loaded",
        "machine is white."
      ]
    },
    {
      "title": "Pad row 4",
      "lines": [
        "Play/Stop, Fill,",
        "Slot focus,",
        "Pattern page,",
        "Edit page,",
        "Copy, Paste, Clear.",
        "",
        "SHIFT + 68 arms",
        "LIVE RECORD.",
        "SHIFT + 71-75 =",
        "Prob, Cond, Micro,",
        "Retrig, ClearLocks."
      ]
    },
    {
      "title": "Knobs and jog",
      "lines": [
        "Knobs 1-8 are the",
        "edit page's eight",
        "parameters.",
        "Jog sets pattern",
        "length, or the held",
        "step's attribute.",
        "Jog click cycles",
        "the edit page."
      ]
    },
    {
      "title": "Trig conditions",
      "lines": [
        "FILL and !FIL react",
        "to the Fill pad.",
        "PRE and !PRE follow",
        "the last condition.",
        "1ST fires only on",
        "the first pass.",
        "A:B fires on pass A",
        "of every B."
      ]
    },
    {
      "title": "Lock behaviour",
      "lines": [
        "Each firing trig is",
        "a full snapshot:",
        "locked params take",
        "their value, others",
        "go back to base.",
        "A trig that does",
        "not fire changes",
        "nothing."
      ]
    },
    {
      "title": "Notes",
      "lines": [
        "Retrig restarts the",
        "LFOs and the filter",
        "envelope, it does",
        "not stutter audio.",
        "Use Degrader FREZ",
        "for that.",
        "Start/continue",
        "restarts pattern."
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "Shift + jog click",
        "opens the browser.",
        "Jog scrolls, click",
        "loads. Top entry",
        "saves a new one.",
        "Clear pad deletes.",
        "",
        "They live outside",
        "the module, so a",
        "reinstall keeps them"
      ]
    },
    {
      "title": "Grainer",
      "lines": [
        "Granulates the last",
        "2 s of live input.",
        "TUNE +/-2 oct, DENS",
        "how often grains",
        "fire, SIZE their",
        "length, POS where",
        "in the buffer, SCAN",
        "moves that point,",
        "SPRD scatters it,",
        "AMNT how many."
      ]
    },
    {
      "title": "The reverbs",
      "lines": [
        "Three different",
        "algorithms, not one",
        "with three presets:",
        "",
        "Rumsklang: room",
        "with early refl.",
        "Steel Box: plate",
        "Supervoid: FDN,",
        "smoothest decay."
      ]
    },
    {
      "title": "Live record",
      "lines": [
        "Shift + Play arms",
        "it. With the seq",
        "running, turning a",
        "knob writes a lock",
        "onto the step that",
        "is playing, and",
        "arms a trig there.",
        "",
        "The play pad turns",
        "red while armed."
      ]
    },
    {
      "title": "Probability",
      "lines": [
        "Per step, 1-100.",
        "Separate from the",
        "trig condition:",
        "both must pass.",
        "",
        "Shift + pattern page",
        "picks the mode,",
        "then hold a step",
        "and turn the jog."
      ]
    },
    {
      "title": "Modulation",
      "lines": [
        "Three FX LFOs now,",
        "plus an AHD mod",
        "envelope that fires",
        "on every trig.",
        "",
        "Edit page cycles",
        "FX, LFO 1-3, Mod",
        "Env, Global."
      ]
    },
    {
      "title": "MIDI CC",
      "lines": [
        "External CC only.",
        "CC 8-15  FX1 A-H",
        "CC 16-23 FX2 A-H",
        "CC 24/25 machines",
        "CC 26    dry/wet",
        "CC 32/40/48 LFOs",
        "CC 56-60 mod env",
        "CC 64/65/66 = seq,",
        "fill, live record."
      ]
    },
    {
      "title": "Pattern bank",
      "lines": [
        "16 patterns.",
        "SHIFT + a step",
        "button selects one.",
        "",
        "The screen header",
        "shows P1-P16, and",
        "S when song mode",
        "is running."
      ]
    },
    {
      "title": "Undo and song",
      "lines": [
        "Pad 81: undo,",
        "shift+tap = redo.",
        "Pad 82: tap recalls,",
        "hold memorizes.",
        "Pad 83: song mode.",
        "",
        "Song rows chain",
        "patterns with",
        "repeat counts."
      ]
    },
    {
      "title": "Trig types",
      "lines": [
        "A full trig applies",
        "its locks AND",
        "restarts the LFOs",
        "and envelope.",
        "",
        "A lock trig applies",
        "locks only —",
        "Elektron's trigless",
        "lock."
      ]
    }
  ]
}
